#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp CAPSLOCK  &kp N1  &kp N2  &kp N3            &kp N4  &kp N5                     &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp DELETE
&kp ESCAPE    &kp Q   &kp W   &kp E             &kp R   &kp T                      &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB       &kp A   &kp S   &kp D             &kp F   &kp G                      &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT     &kp Z   &kp X   &kp C             &kp V   &kp B      &none    &none  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                              &kp LEFT_COMMAND  &mo 1   &kp SPACE  &none    &none  &kp SPACE  &mo 2   &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer1 {
            bindings = <
&trans     &none  &none  &none   &none   &none                   &none     &none             &none   &none             &none      &trans
&kp GRAVE  &none  &none  &none   &none   &none                   &kp FSLH  &kp N7            &kp N8  &kp N9            &kp MINUS  &trans
&kp TILDE  &none  &none  &none   &none   &none                   &kp STAR  &kp LS(NUMBER_4)  &kp N5  &kp LS(NUMBER_6)  &kp PLUS   &kp EQUAL
&trans     &none  &none  &none   &none   &none   &none    &none  &none     &kp N1            &kp N2  &kp LS(NUMBER_3)  &kp DOT    &none
                         &trans  &trans  &trans  &none    &none  &kp N0    &trans            &trans
            >;
        };

        layer2 {
            bindings = <
&trans    &none   &none   &none      &none    &none                    &none      &none     &none           &none            &none            &trans
&kp CAPS  &kp F1  &kp F2  &kp F3     &kp F4   &kp F5                   &kp PG_UP  &kp HOME  &kp UP          &kp END          &kp PRINTSCREEN  &kp DEL
&kp TAB   &kp F6  &kp F7  &kp F8     &kp F9   &kp F10                  &kp PG_DN  &kp LEFT  &kp DOWN        &kp RIGHT        &kp PIPE         &kp UNDER
&trans    &none   &none   &kp LCTRL  &kp F11  &kp F12  &none    &none  &kp LBKT   &kp RBKT  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp BSLH         &trans
                          &trans     &trans   &trans   &none    &none  &kp SPACE  &trans    &trans
            >;
        };

        layer3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none       &none         &none            &none  &none
&none       &out OUT_BLE  &none         &none         &none         &none                         &none  &none       &none         &none            &none  &none
&none       &out OUT_USB  &none         &none         &none         &none                         &none  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &none  &none
&none       &sys_reset    &bootloader   &none         &none         &none         &none    &none  &none  &none       &none         &soft_off        &none  &none
                                        &none         &none         &none         &none    &none  &none  &trans      &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
